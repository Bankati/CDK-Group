# ───────────────────────────────────────────────────────────────
# OCD Live — variables d'environnement
# Copier ce fichier vers .env.local (en local) ou les saisir dans Vercel.
# Tout est FACULTATIF : sans rien, le site tourne en MODE DÉMO.
# ───────────────────────────────────────────────────────────────

# Adresse publique du site (ex. https://ocd-live.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé de secours de l'Espace Bovann : création du compte admin et récupération si l'email
# est perdu (en démo : bovann2026 ; OBLIGATOIRE avec Supabase). Le mot de passe de
# connexion, lui, est choisi dans le site et stocké en empreinte (jamais en clair).
ADMIN_PASSWORD=
# Clé secrète pour signer la session (32 caractères au hasard)
ADMIN_SECRET=

# Supabase (étape 2) — Project Settings > API Keys (clé secrète sb_secret_… ou service_role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (étape 2) — https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur : une adresse d'un domaine VÉRIFIÉ dans Resend (sinon seul le titulaire du compte reçoit)
RESEND_FROM=OCD Live <onboarding@resend.dev>
# Adresse qui reçoit les notifications de nouvelles réservations
NOTIFICATION_EMAIL=contact@bovanngroup.com
